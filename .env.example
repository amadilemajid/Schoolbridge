# ============================================================
# SchoolBridge — Environment Variables Template
# Copy to .env and fill in values before running.
# NEVER commit .env to version control.
# ============================================================

# Django
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=app.schoolbridge.ug,www.schoolbridge.ug
FRONTEND_URL=https://app.schoolbridge.ug

# Database (PostgreSQL)
DB_NAME=schoolbridge
DB_USER=schoolbridge_app
DB_PASSWORD=strong-database-password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# PII Encryption (AES-256 via Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# List for key rotation: FERNET_KEYS=newkey,oldkey
FERNET_KEYS=your-fernet-key-here

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@schoolbridge.ug
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=SchoolBridge <noreply@schoolbridge.ug>

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=schoolbridge_verify_token_change_me

# Africa's Talking SMS (Uganda)
AT_USERNAME=your-at-username
AT_API_KEY=your-at-api-key
AT_SENDER_ID=SchoolBridge

# Sentry (Error monitoring)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=https://app.schoolbridge.ug

# File Storage (DigitalOcean Spaces / S3)
USE_S3=True
AWS_ACCESS_KEY_ID=your-spaces-key
AWS_SECRET_ACCESS_KEY=your-spaces-secret
AWS_STORAGE_BUCKET_NAME=schoolbridge-files
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_S3_REGION_NAME=nyc3
